# Copy this file to .env and fill in the values (never commit .env).
#   bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example .env
#
# Passwords and secrets: use letters and digits only (no @ : / # %), because
# some of them are placed inside connection URIs. To generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ---------------------------------------------------------------- versions
SUPERSET_VERSION=7.0.0rc2
TRINO_VERSION=476
# Optional, default v1.8.6
# CUBE_VERSION=v1.8.6

# ---------------------------------------------------------------- Superset
# Signs Superset sessions. Use a long random value.
SUPERSET_SECRET_KEY=change-me
# Password of Superset's own metadata database (superset-db container)
SUPERSET_DB_PASSWORD=change-me
# Admin account: log in to http://localhost:8088 with it; sync.py uses it too
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------- warehouse
# Password of the sample warehouse Postgres (read by Trino)
WAREHOUSE_DB_PASSWORD=change-me

# ---------------------------------------------------------------- Cube (external semantic layer)
# Signs Cube API tokens. Use a long random value.
CUBE_API_SECRET=change-me
# Password of Cube's SQL API; Superset's "Cube" connection uses it
CUBE_SQL_PASSWORD=change-me

# ---------------------------------------------------------------- optional
# Shown as each dataset's source link in Superset (leave empty locally)
GIT_REPO_URL=
